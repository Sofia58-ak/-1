    "# 1. БАЗОВЫЙ КЛАСС (Предок — любое млекопитающее)\n",
    "class Mammal:\n",
    "    def __init__(self, name, body_temperature):\n",
    "        # Свойство 1\n",
    "        self.name = name\n",
    "        # Свойство 2\n",
    "        self.body_temperature = body_temperature\n",
    "\n",
    "    # Метод 1\n",
    "    def nurse_young(self):\n",
    "        print(f\"[{self.__class__.__name__}] {self.name} вскармливает детёнышей молоком.\")\n",
    "\n",
    "    # Метод 2\n",
    "    def breathe(self):\n",
    "        print(f\"[{self.__class__.__name__}] {self.name} дышит воздухом (температура тела: {self.body_temperature}°C).\")\n",
    "\n",
    "\n",
    "# 2. ПРОМЕЖУТОЧНЫЙ КЛАСС (Наследует Mammal)\n",
    "class AquaticMammal(Mammal):\n",
    "    def __init__(self, name, body_temperature, habitat, max_depth):\n",
    "        super().__init__(name, body_temperature)\n",
    "        # Свойство 3\n",
    "        self.habitat = habitat\n",
    "        # Свойство 4\n",
    "        self.max_depth = max_depth\n",
    "\n",
    "    # Метод 3\n",
    "    def dive(self):\n",
    "        print(f\"[{self.__class__.__name__}] {self.name} ныряет в {self.habitat} \"\n",
    "              f\"на глубину до {self.max_depth} метров.\")\n",
    "\n",
    "\n",
    "# 3. КОНЕЧНЫЙ КЛАСС (\"Наш класс\", наследует AquaticMammal)\n",
    "class Dolphin(AquaticMammal):\n",
    "    def __init__(self, name, body_temperature, habitat, max_depth, pod_size, species):\n",
    "        super().__init__(name, body_temperature, habitat, max_depth)\n",
    "        # Свойство 5\n",
    "        self.pod_size = pod_size\n",
    "        # Дополнительное служебное (не входит в счёт 5 основных)\n",
    "        self.species = species\n",
    "\n",
    "    # Метод 4\n",
    "    def echolocate(self):\n",
    "        print(f\"[{self.__class__.__name__}] {self.name} посылает звуковые щелчки \"\n",
    "              f\"и строит 'акустическую картину' вокруг себя.\")\n",
    "\n",
    "    # Метод 5 (Использует наследуемые свойства)\n",
    "    def communicate(self):\n",
    "        print(f\"[{self.__class__.__name__}] {self.name} общается со своей стаей \"\n",
    "              f\"из {self.pod_size} особей с помощью свистов и щелчков.\")\n",
    "\n",
    "    # КАК НАШ КЛАСС ДОПОЛНЯЕТ ПРЕДЫДУЩИЕ (Переопределение)\n",
    "    # Дельфин дышит не как обычное млекопитающее — у него есть дыхало\n",
    "    def breathe(self):\n",
    "        super().breathe()  # Вызываем базовую логику предка\n",
    "        print(f\"       -> При этом {self.name} делает это через специальное дыхало на голове, \"\n",
    "              f\"всплывая на поверхность {self.habitat}.\")\n",
    "\n",
    "\n",
    "# ================= ПРОВЕРКА =================\n",
    "\n",
    "print(\"--- Создаём нашего дельфина (Конечный класс) ---\")\n",
    "my_dolphin = Dolphin(\n",
    "    name=\"Флиппер\",\n",
    "    body_temperature=36.6,\n",
    "    habitat=\"Тихий океан\",\n",
    "    max_depth=300,\n",
    "    pod_size=15,\n",
    "    species=\"афалина\"\n",
    ")\n",
    "\n",
    "print(\"\\n--- Демонстрация наследования (Свойства) ---\")\n",
    "# Свойства, полученные от предков:\n",
    "print(f\"Имя (от Mammal): {my_dolphin.name}\")\n",
    "print(f\"Температура тела (от Mammal): {my_dolphin.body_temperature}°C\")\n",
    "print(f\"Среда обитания (от AquaticMammal): {my_dolphin.habitat}\")\n",
    "print(f\"Макс. глубина (от AquaticMammal): {my_dolphin.max_depth} м\")\n",
    "# Собственное свойство нашего класса:\n",
    "print(f\"Размер стаи (собственное): {my_dolphin.pod_size}\")\n",
    "\n",
    "print(\"\\n--- Демонстрация наследования (Методы) ---\")\n",
    "my_dolphin.nurse_young()  # Метод от Mammal\n",
    "my_dolphin.dive()         # Метод от AquaticMammal\n",
    "my_dolphin.echolocate()   # Собственный метод Dolphin\n",
    "my_dolphin.communicate()  # Собственный метод Dolphin\n",
    "\n",
    "print(\"\\n--- Демонстрация дополнения (Переопределение) ---\")\n",
    "my_dolphin.breathe()      # Метод Mammal, дополненный логикой Dolphin"
